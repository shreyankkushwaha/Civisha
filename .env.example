# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Backblaze B2 Storage Configuration
# These must be set to use real cloud storage for image uploads.
# Create a B2 bucket and generate Application Keys in your Backblaze account.
# Ensure the keys are kept secret and only configured server-side.
B2_ENDPOINT="https://s3.eu-central-003.backblazeb2.com"
B2_REGION="eu-central-003"
B2_BUCKET_NAME="my-civisha-bucket"
B2_KEY_ID="my_b2_key_id"
B2_APP_KEY="my_b2_application_key"

# X / Twitter API Configuration
# Used for publishing civic issues automatically after admin approval.
X_API_KEY="my_x_api_key"
X_API_SECRET="my_x_api_secret"
X_ACCESS_TOKEN="my_x_access_token"
X_ACCESS_SECRET="my_x_access_secret"

# Firebase Admin Configuration (for Vercel SSR meta tags, sitemap, and Admin X routes)
FIREBASE_PROJECT_ID="civishatest2"
FIREBASE_SERVICE_ACCOUNT_KEY=""
